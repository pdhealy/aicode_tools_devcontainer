{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${COPILOT_CLI:-}\" ] && NODE=$(command -v node 2>/dev/null || ls /vscode/vscode-server/bin/linux-arm64/*/node 2>/dev/null | head -1 || echo \"\"); [ -n \"$NODE\" ] && \"$NODE\" .claude/hooks/log_activity.js",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|Read|Glob|Grep|Agent|Task|WebFetch|WebSearch|NotebookEdit|TodoWrite|TodoRead",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${COPILOT_CLI:-}\" ] && mkdir -p .claude/logs && jq -r '\"[\" + (now | strftime(\"%Y-%m-%d %H:%M:%S\")) + \"] \" + .tool_name + \" | \" + (if .tool_input.command then .tool_input.command elif .tool_input.file_path then .tool_input.file_path elif .tool_input.pattern then (\"pattern=\" + .tool_input.pattern) else (.tool_input | tojson | .[0:200]) end)' >> .claude/logs/command.log 2>/dev/null || true",
            "async": true
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${COPILOT_CLI:-}\" ] && NODE=$(command -v node 2>/dev/null || ls /vscode/vscode-server/bin/linux-arm64/*/node 2>/dev/null | head -1 || echo \"\"); [ -n \"$NODE\" ] && \"$NODE\" .claude/hooks/log_activity.js",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${COPILOT_CLI:-}\" ] && NODE=$(command -v node 2>/dev/null || ls /vscode/vscode-server/bin/linux-arm64/*/node 2>/dev/null | head -1 || echo \"\"); [ -n \"$NODE\" ] && \"$NODE\" .claude/hooks/log_activity.js",
            "async": true
          }
        ]
      }
    ]
  }
}
